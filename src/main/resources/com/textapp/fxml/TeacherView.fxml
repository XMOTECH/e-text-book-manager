<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<BorderPane prefHeight="600.0" prefWidth="900.0" stylesheets="@../css/teacherStyle.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.textapp.controller.TeacherController">
   <left>
      <VBox fx:id="sidebar" prefHeight="200.0" prefWidth="200.0" spacing="15.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="10.0" />
         </padding>
         <children>
            <Label prefHeight="25.0" prefWidth="135.0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2D3748;" text="Tableau de bord" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <ImageView fitHeight="16.0" fitWidth="16.0">
                     <image>
                        <Image url="@../images/add.png" />
                     </image>
                  </ImageView>
                  <Button fx:id="addSessionMenuButton" mnemonicParsing="false" onAction="#showAddSessionForm" text="Ajouter une séance" styleClass="sidebar-button" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <ImageView fitHeight="16.0" fitWidth="16.0">
                     <image>
                        <Image url="@../images/book.png" />
                     </image>
                  </ImageView>
                  <Button fx:id="myCoursesMenuButton" mnemonicParsing="false" onAction="#showCoursesList" text="Mes cours" styleClass="sidebar-button" />
               </children>
            </HBox>
            <Region VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <ImageView fitHeight="16.0" fitWidth="16.0">
                     <image>
                        <Image url="@../images/logout.png" />
                     </image>
                  </ImageView>
                  <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#logout" text="Déconnexion" />
               </children>
            </HBox>
         </children>
      </VBox>
   </left>
   <center>
      <StackPane fx:id="mainContentArea" prefHeight="200.0" prefWidth="200.0">
         <children>
            <VBox fx:id="addSessionForm" prefHeight="400.0" prefWidth="500.0" spacing="15.0" visible="false" StackPane.alignment="CENTER">
               <children>
                  <Label style="-fx-font-size: 20px; -fx-text-fill: #2D3748;" text="Nouvelle séance" />
                  <HBox spacing="10.0">
                     <children>
                        <Label text="Cours :" style="-fx-font-size: 14px;" />
                        <ComboBox fx:id="courseComboBox" prefWidth="200.0" />
                     </children>
                  </HBox>
                  <HBox spacing="10.0">
                     <children>
                        <Label text="Date :" style="-fx-font-size: 14px;" />
                        <DatePicker fx:id="datePicker" />
                     </children>
                  </HBox>
                  <TextArea fx:id="contentArea" prefHeight="100.0" prefWidth="400.0" promptText="Entrez le contenu de la séance…" />
                  <Button fx:id="addSessionButton" mnemonicParsing="false" onAction="#addSession" text="Ajouter" />
               </children>
            </VBox>
            <TableView fx:id="sessionTable" prefHeight="200.0" prefWidth="200.0">
               <columns>
                  <TableColumn fx:id="courseColumn" prefWidth="100.0" text="Cours ID" />
                  <TableColumn fx:id="dateColumn" prefWidth="150.0" text="Date" />
                  <TableColumn fx:id="contentColumn" prefWidth="200.0" text="Contenu" />
                  <TableColumn fx:id="validatedColumn" prefWidth="100.0" text="Validé" />
               </columns>
            </TableView>
            <HBox alignment="CENTER" prefHeight="30.0" prefWidth="200.0">
               <children>
                  <Label fx:id="messageLabel" />
               </children>
            </HBox>
         </children>
      </StackPane>
   </center>
</BorderPane>
